APP_HOST=127.0.0.1
APP_PORT=8000
UPDATE_INTERVAL_MINUTES=60
REFRESH_ON_STARTUP=true

# Networking / cortesia verso le fonti
REQUEST_TIMEOUT_SECONDS=20
REQUEST_RETRIES=2
REQUEST_DELAY_SECONDS=0.8
# Inserisci un contatto reale dell'organizzazione se desiderato.
USER_AGENT=DomusDeLunaGrantMonitor/0.1 (non-commercial grant monitoring)
# Se true, un robots.txt irraggiungibile blocca lo scraping. Un Disallow esplicito blocca comunque la fonte.
ROBOTS_STRICT=false

# Limiti degli aggregatori nazionali attivi
INFOBANDI_MAX_PAGES=10
CONFINIONLINE_MAX_PAGES=12

# Impostare solo se verificato per Domus de Luna: yes / no / unknown.
# Le vecchie variabili OPEN_ARMS_* non vengono usate per l'ammissibilità Domus.
DOMUS_RUNTS=unknown
DOMUS_ASSOCIATION_REGISTER=unknown

# Google Sheets opzionale
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET=Bandi
GOOGLE_SERVICE_ACCOUNT_FILE=

# Nuove fonti (v0.2) - facoltativo: i default funzionano anche con il vecchio .env
ADDITIONAL_MAX_PAGES=3
ADDITIONAL_MAX_DETAILS=35
EU_MAX_PAGES_PER_QUERY=3
EU_PAGE_SIZE=50
REFRESH_MAX_WORKERS=3
